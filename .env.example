# 复制为 .env 后按需填写。不要把 .env 提交到仓库。
# 已存在的环境变量优先于 .env。改完可在侧边栏点「重新加载 .env」，或重启程序。

# auto：检测到 MediaCrawler 且具备登录方式时走实时，否则用演示数据
# demo：始终演示    live：始终实时（缺配置时会在页面上说明原因）
APP_MODE=auto

DATABASE_PATH=data/hongsearch.db

# OpenAI 兼容接口。可以用 OpenAI、DeepSeek 或其他兼容服务。
# 地址需要能访问到 /v1/chat/completions，下面这种写法即可。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 本机 MediaCrawler 目录（实时模式）。不要把那个仓库提交进本项目。
MEDIACRAWLER_HOME=
# 留空时：若目录里有 .venv 就用它，否则用当前 Python。
# 也可以写成：uv run python
MEDIACRAWLER_PYTHON=

# 只支持 cookie 或 qrcode。验证码和扫码请你自己在浏览器里完成。
LOGIN_TYPE=cookie
# 只放在本机环境变量里。程序不会把 Cookie 写进命令行参数。
XHS_COOKIES=
DY_COOKIES=

# 单次每个平台最多采集的公开内容条数。程序会把上限压在 20。
MAX_NOTES=8
# 每条内容最多保留的一级评论数。程序会把上限压在 10。不抓二级评论。
MAX_COMMENTS=5
CRAWLER_TIMEOUT_SEC=240
INTER_PLATFORM_SLEEP_SEC=3
# 无头模式经常无法完成登录确认，不建议打开。
MEDIACRAWLER_HEADLESS=false

# 历史里同类结果少于此数量时，才触发一次新的采集。
MIN_CACHE_RESULTS=3
DISPLAY_LIMIT=12
